# Render/install with scripts/install_systemd.py after foreground validation.
# @...@ values are filled by the installer; do not install this template directly.
[Unit]
Description=All Sky Alert predictions and General Pi Camera / Timelapse
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@PROJECT_DIR@
# ':' disables environment-variable expansion in paths/arguments.
ExecStart=:@PYTHON@ -m all_sky_alert --config @CONFIG@ serve
SupplementaryGroups=video
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=300
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
# Camera requires real /dev/video*, /dev/media* and /dev/dma_heap/*.
# Do not add PrivateDevices=true, a device whitelist, or ProtectHome=true.
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
